{
  "name": "polycode-ide",
  "version": "1.0.0",
  "description": "AI-Powered IDE with Multi-Model Deliberation Architecture",
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "webpack --config webpack.config.optimized.js",
    "start": "npm run build:renderer && electron .",
    "dev": "webpack --config webpack.config.optimized.js --watch && electron . --dev",
    "watch": "webpack --watch --config webpack.config.optimized.js",
    "analyze": "webpack --config webpack.config.optimized.js --profile",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "npm run build:renderer && electron-builder",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:linux": "npm run build:renderer && electron-builder --linux"
  },
  "keywords": [
    "ide",
    "ai",
    "llm",
    "code-editor",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.23.3",
    "@types/jest": "^30.0.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "jest": "^30.2.0",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "axios": "^1.6.2",
    "monaco-editor": "^0.45.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "webpack-bundle-analyzer": "^4.10.1"
  },
  "build": {
    "appId": "com.polycode.ide",
    "productName": "PolyCode IDE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
