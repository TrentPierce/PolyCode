      "\t\tconsole.error(err);",
      "\t\treturn;",
      "\t}",
      "\tconsole.log('File deleted!');"
      "});"
    ],
    "language": "javascript"
  },
  "event emitter": {
    "prefix": "emitter",
    "description": "EventEmitter",
    "body": [
      "const EventEmitter = require('events');",
      "const emitter = new EventEmitter();"
    ],
    "language": "javascript"
  },
  "event emitter on": {
    "prefix": "emitterOn",
    "description": "EventEmitter on",
    "body": [
      "emitter.on('${1:eventName}', (${2:args}) => {",
      "\t${3:// handle event}",
      "});"
    ],
    "language": "javascript"
  },
  "event emitter emit": {
    "prefix": "emitterEmit",
    "description": "EventEmitter emit",
    "body": [
      "emitter.emit('${1:eventName}', ${2:args});"
    ],
    "language": "javascript"
  },
  "event emitter once": {
    "prefix": "emitterOnce",
    "description": "EventEmitter once",
    "body": [
      "emitter.once('${1:eventName}', (${2:args}) => {",
      "\t${3:// handle event}",
      "});"
    ],
    "language": "javascript"
  },
  "readable stream": {
    "prefix": "readableStream",
    "description": "Readable Stream",
    "body": [
      "const readable = fs.createReadStream('${1:filePath}');",
      "",
      "readable.on('data', (chunk) => {",
      "\tconsole.log('Received chunk:', chunk);",
      "});",
      "",
      "readable.on('end', () => {",
      "\tconsole.log('Stream finished');",
      "});",
      "",
      "readable.on('error', (err) => {",
      "\tconsole.error('Stream error:', err);",
      "});"
    ],
    "language": "javascript"
  },
  "writable stream": {
    "prefix": "writableStream",
    "description": "Writable Stream",
    "body": [
      "const writable = fs.createWriteStream('${1:filePath}');",
      "",
      "writable.write('${1:content}');",
      "writable.end();",
      "",
      "writable.on('finish', () => {",
      "\tconsole.log('Write complete');",
      "});",
      "",
      "writable.on('error', (err) => {",
      "\tconsole.error('Write error:', err);",
      "});"
    ],
    "language": "javascript"
  },
  "pipe stream": {
    "prefix": "pipe",
    "description": "Pipe Stream",
    "body": [
      "const readable = fs.createReadStream('${1:inputPath}');",
      "const writable = fs.createWriteStream('${2:outputPath}');",
      "",
      "readable.pipe(writable);"
    ],
    "language": "javascript"
  },
  "mongoose schema": {
    "prefix": "mongooseSchema",
    "description": "Mongoose Schema",
    "body": [
      "const mongoose = require('mongoose');",
      "",
      "const ${1:ModelName}Schema = new mongoose.Schema({",
      "\t${2:fieldName}: {",
      "\t\ttype: ${3:String},",
      "\t\trequired: true",
      "\t}",
      "}, { timestamps: true });",
      "",
      "const ${1:ModelName} = mongoose.model('${1:ModelName}', ${1:ModelName}Schema);",
      "module.exports = ${1:ModelName};"
    ],
    "language": "javascript"
  },
