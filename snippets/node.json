  },
  "http request": {
    "prefix": "https",
    "description": "HTTP Request",
    "body": [
      "https.get('${1:url}', (res) => {",
      "\tlet data = '';",
      "",
      "\tres.on('data', (chunk) => {",
      "\t\tdata += chunk;",
      "\t});",
      "",
      "\tres.on('end', () => {",
      "\t\tconsole.log(JSON.parse(data));",
      "\t});",
      "}).on('error', (err) => {",
      "\tconsole.error('Error:', err.message);",
      "});"
    ],
    "language": "javascript"
  },
  "http server": {
    "prefix": "httpServer",
    "description": "HTTP Server",
    "body": [
      "const http = require('http');",
      "const PORT = ${1:3000};",
      "",
      "const server = http.createServer((req, res) => {",
      "\tres.statusCode = 200;",
      "\tres.setHeader('Content-Type', 'text/plain');",
      "\tres.end('Hello World!');",
      "});",
      "",
      "server.listen(PORT, () => {",
      "\tconsole.log(`Server running at http://localhost:${PORT}/`);",
      "});"
    ],
    "language": "javascript"
  },
