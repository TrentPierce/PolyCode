{
  "express server": {
    "prefix": "express",
    "description": "Express HTTP Server",
    "body": [
      "const express = require('express');",
      "const app = express();",
      "const PORT = process.env.PORT || ${1:3000};",
      "",
      "// Middleware",
      "app.use(express.json());",
      "app.use(express.urlencoded({ extended: true }));",
      "",
      "// Routes",
      "app.get('/', (req, res) => {",
      "\tres.send('Hello World!');",
      "});",
      "",
      "// Start server",
      "app.listen(PORT, () => {",
      "\tconsole.log(`Server running on port ${PORT}`);",
      "});"
    ],
    "language": "javascript"
  },
  "express router": {
    "prefix": "expressRouter",
    "description": "Express Router",
    "body": [
      "const express = require('express');",
      "const router = express.Router();",
      "",
      "router.get('/', (req, res) => {",
      "\t${1:// code}",
      "});",
      "",
      "router.post('/', (req, res) => {",
      "\t${2:// code}",
      "});",
      "",
      "router.put('/:id', (req, res) => {",
      "\t${3:// code}",
      "});",
      "",
      "router.delete('/:id', (req, res) => {",
      "\t${4:// code}",
      "});",
      "",
      "module.exports = router;"
    ],
    "language": "javascript"
  },
  "express middleware": {
    "prefix": "expressMiddleware",
    "description": "Express Middleware",
    "body": [
      "const ${1:middlewareName} = (req, res, next) => {",
      "\t${2:// middleware logic}",
      "\tnext();",
      "};"
    ],
    "language": "javascript"
  },
  "express error handler": {
    "prefix": "expressError",
    "description": "Express Error Handler",
    "body": [
      "app.use((err, req, res, next) => {",
      "\tconsole.error(err.stack);",
      "\tres.status(${1:500}).json({",
      "\t\terror: err.message",
      "\t});",
      "});"
    ],
    "language": "javascript"
  },
  "koa server": {
    "prefix": "koa",
    "description": "Koa HTTP Server",
    "body": [
      "const Koa = require('koa');",
      "const app = new Koa();",
      "const PORT = ${1:3000};",
      "",
      "// Middleware",
      "app.use(async (ctx) => {",
      "\tctx.body = 'Hello World!';",
      "});",
      "",
      "app.listen(PORT, () => {",
      "\tconsole.log(`Server running on port ${PORT}`);",
      "});"
    ],
    "language": "javascript"
  },
  "koa router": {
    "prefix": "koaRouter",
    "description": "Koa Router",
    "body": [
      "const Router = require('@koa/router');",
      "const router = new Router();",
      "",
      "router.get('/', async (ctx) => {",
      "\tctx.body = '${1:response}';",
      "});",
      "",
      "router.post('/', async (ctx) => {",
      "\tctx.body = '${2:response}';",
      "});",
      "",
      "module.exports = router;"
    ],
    "language": "javascript"
  },
  "fastify server": {
    "prefix": "fastify",
    "description": "Fastify HTTP Server",
    "body": [
      "const fastify = require('fastify')({ logger: true });",
      "const PORT = ${1:3000};",
      "",
      "fastify.get('/', async (request, reply) => {",
      "\treturn { hello: 'world' };",
      "});",
      "",
      "fastify.listen(PORT, (err) => {",
      "\tif (err) {",
      "\t\tfastify.log.error(err);",
      "\t\tprocess.exit(1);",
      "\t}",
      "});"
    ],
    "language": "javascript"
  },
  "fs.readFile": {
    "prefix": "fsRead",
    "description": "fs.readFile",
    "body": [
      "fs.readFile('${1:filePath}', 'utf8', (err, data) => {",
      "\tif (err) {",
      "\t\tconsole.error(err);",
      "\t\treturn;",
      "\t}",
      "\tconsole.log(data);",
      "});"
    ],
    "language": "javascript"
  },
  "fs.readFile promise": {
    "prefix": "fsReadPromise",
    "description": "fs.promises.readFile",
    "body": [
      "const data = await fs.promises.readFile('${1:filePath}', 'utf8');"
    ],
    "language": "javascript"
  },
  "fs.writeFile": {
    "prefix": "fsWrite",
    "description": "fs.writeFile",
    "body": [
      "fs.writeFile('${1:filePath}', '${2:content}', 'utf8', (err) => {",
      "\tif (err) {",
      "\t\tconsole.error(err);",
      "\t\treturn;",
      "\t}",
      "\tconsole.log('File saved!');",
      "});"
    ],
    "language": "javascript"
  },
  "fs.writeFile promise": {
    "prefix": "fsWritePromise",
    "description": "fs.promises.writeFile",
    "body": [
      "await fs.promises.writeFile('${1:filePath}', '${2:content}', 'utf8');"
    ],
    "language": "javascript"
  },
  "fs.readdir": {
    "prefix": "fsReaddir",
    "description": "fs.readdir",
    "body": [
      "fs.readdir('${1:directory}', (err, files) => {",
      "\tif (err) {",
      "\t\tconsole.error(err);",
      "\t\treturn;",
      "\t}",
      "\tconsole.log(files);",
      "});"
    ],
    "language": "javascript"
  },
  "fs.mkdir": {
    "prefix": "fsMkdir",
    "description": "fs.mkdir",
    "body": [
